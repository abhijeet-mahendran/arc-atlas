{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Arc AtlaS",
            "type": "shell",
            "command": "gcc",
            "args": [
                "src/main.c",
                "src/rover.c",
                "-Iinclude",
                "-o",
                "arc-atlas.exe",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Arc AtlaS",
            "type": "shell",
            "command": ".\\arc-atlas.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Run Arc AtlaS",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Arc AtlaS",
                "Run Arc AtlaS"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}