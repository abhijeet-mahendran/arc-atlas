{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run Arc Atlas",
            "type": "shell",
            "command": "gcc src/*.c -Iinclude -o arc-atlas.exe && arc-atlas.exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}