{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Rover DLL",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-shared",
                "-Iinclude",
                "src/rover.c",
                "src/integrator.c",
                "-o",
                "rover.dll",
                "-lm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}